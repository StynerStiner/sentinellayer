{
  "name": "paperclip",
  "version": "1.0.0",
  "description": "Paperclip — Autonomous AI Operations Layer for BenefitsSafe",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx tsx watch src/index.ts",
    "agent:watchdog": "npx tsx src/index.ts --agent watchdog --once",
    "agent:compliance": "npx tsx src/index.ts --agent compliance --once",
    "agent:reporter": "npx tsx src/index.ts --agent reporter --once",
    "agent:onboarding": "npx tsx src/index.ts --agent onboarding --once",
    "agent:trial-monitor": "npx tsx src/index.ts --agent trial-monitor --once",
    "generate": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "prisma": "^7.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
