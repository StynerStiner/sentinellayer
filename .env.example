# Paperclip — Autonomous AI Operations Layer
# Connects to the SAME Aurora PostgreSQL as BenefitsSafe

# Database (same Aurora instance as BenefitsSafe)
DATABASE_URL=postgresql://postgres:PASSWORD@benefitssafe-db.cluster-xxx.us-east-2.rds.amazonaws.com:5432/benefitssafe?sslmode=require

# Agent intervals
WATCHDOG_INTERVAL_HOURS=24
COMPLIANCE_INTERVAL_HOURS=6
REPORTER_INTERVAL_DAYS=7
ONBOARDING_INTERVAL_HOURS=12

# Alert thresholds (0.0 to 1.0)
ALERT_THRESHOLD_WARNING=0.80
ALERT_THRESHOLD_CRITICAL=0.90

# Logging
LOG_LEVEL=info
NODE_ENV=production
